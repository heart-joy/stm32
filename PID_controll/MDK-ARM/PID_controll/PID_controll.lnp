--cpu Cortex-M3
"pid_controll\startup_stm32f103xb.o"
"pid_controll\main.o"
"pid_controll\gpio.o"
"pid_controll\adc.o"
"pid_controll\i2c.o"
"pid_controll\tim.o"
"pid_controll\stm32f1xx_it.o"
"pid_controll\stm32f1xx_hal_msp.o"
"pid_controll\stm32f1xx_hal_gpio_ex.o"
"pid_controll\stm32f1xx_hal_adc.o"
"pid_controll\stm32f1xx_hal_adc_ex.o"
"pid_controll\stm32f1xx_hal.o"
"pid_controll\stm32f1xx_hal_rcc.o"
"pid_controll\stm32f1xx_hal_rcc_ex.o"
"pid_controll\stm32f1xx_hal_gpio.o"
"pid_controll\stm32f1xx_hal_dma.o"
"pid_controll\stm32f1xx_hal_cortex.o"
"pid_controll\stm32f1xx_hal_pwr.o"
"pid_controll\stm32f1xx_hal_flash.o"
"pid_controll\stm32f1xx_hal_flash_ex.o"
"pid_controll\stm32f1xx_hal_exti.o"
"pid_controll\stm32f1xx_hal_i2c.o"
"pid_controll\stm32f1xx_hal_tim.o"
"pid_controll\stm32f1xx_hal_tim_ex.o"
"pid_controll\system_stm32f1xx.o"
"pid_controll\motor.o"
"pid_controll\oled.o"
"pid_controll\oled_data.o"
--strict --scatter "PID_controll\PID_controll.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "PID_controll.map" -o PID_controll\PID_controll.axf
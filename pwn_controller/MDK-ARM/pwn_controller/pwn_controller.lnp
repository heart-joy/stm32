--cpu Cortex-M3
"pwn_controller\startup_stm32f103xb.o"
"pwn_controller\main.o"
"pwn_controller\gpio.o"
"pwn_controller\i2c.o"
"pwn_controller\tim.o"
"pwn_controller\stm32f1xx_it.o"
"pwn_controller\stm32f1xx_hal_msp.o"
"pwn_controller\stm32f1xx_hal_gpio_ex.o"
"pwn_controller\stm32f1xx_hal_i2c.o"
"pwn_controller\stm32f1xx_hal.o"
"pwn_controller\stm32f1xx_hal_rcc.o"
"pwn_controller\stm32f1xx_hal_rcc_ex.o"
"pwn_controller\stm32f1xx_hal_gpio.o"
"pwn_controller\stm32f1xx_hal_dma.o"
"pwn_controller\stm32f1xx_hal_cortex.o"
"pwn_controller\stm32f1xx_hal_pwr.o"
"pwn_controller\stm32f1xx_hal_flash.o"
"pwn_controller\stm32f1xx_hal_flash_ex.o"
"pwn_controller\stm32f1xx_hal_exti.o"
"pwn_controller\stm32f1xx_hal_tim.o"
"pwn_controller\stm32f1xx_hal_tim_ex.o"
"pwn_controller\system_stm32f1xx.o"
"pwn_controller\motor.o"
"pwn_controller\oled.o"
"pwn_controller\oled_data.o"
--library_type=microlib --strict --scatter "pwn_controller\pwn_controller.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "pwn_controller.map" -o pwn_controller\pwn_controller.axf